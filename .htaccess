# ─────────────────────────────────────────────────────────────
#  Business Health Check — Apache / LiteSpeed settings
# ─────────────────────────────────────────────────────────────
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Source code, SQL and repo files are not part of the website.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(web|db|\.git|\.github|\.claude)(/|$) - [F,L]
  RewriteRule ^(README\.md|\.env.*|.*\.code-workspace|.*\.sql)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  # Built JS/CSS have content hashes in their names → safe to cache for a year.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages always revalidate, so a new deploy shows up immediately.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
