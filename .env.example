# ── Copy this file to .env (or fill in api/config.php) ────────
# The PHP API reads api/config.php first; any value missing there
# falls back to these environment variables.

# MySQL / MariaDB
# Local (XAMPP):         host=localhost, port=3306, user=root, password=(empty)
# Railway (production):  copy values from Railway MySQL service → Variables tab
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biz_diagnostic

# One-time code for creating the first admin at /admin/ — long and random (20+ characters).
# Remove it after the admin account exists.
SETUP_TOKEN=
