# ── Copy this file to .env (or fill in api/config.php) ────────
# The PHP API reads api/config.php first; any value missing there
# falls back to these environment variables.

# MySQL / MariaDB
# Local (XAMPP):         host=localhost, port=3306, user=root, password=(empty)
# Railway (production):  copy values from Railway MySQL service → Variables tab
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biz_diagnostic

# One-time code for creating the first admin at /admin/ — long and random (20+ characters).
# Remove it after the admin account exists.
SETUP_TOKEN=

# CRM (ERPNext) connection — see docs/crm-setup.md. Leave CRM_URL empty to switch it off.
CRM_URL=
CRM_API_KEY=
CRM_API_SECRET=
# Public address of this website (used to build the report links sent to the CRM)
SITE_URL=

# OpenAI — optional: summarises the client's note and writes down their voice note (for the team only).
OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
